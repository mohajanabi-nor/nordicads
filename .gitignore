# Secrets
**/.env
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Bundled ML model (large; fetched via scripts/fetch_model.py, re-add via LFS before deploy)
worker/models/*.onnx

# Generated output
worker/output/*
!worker/output/.gitkeep

# Local snapshot DB
worker/*.sqlite3
worker/state/

# Local end-to-end audit — kept on the machine, never published.
# It drives the real app against real customer data, so its screenshots and
# report can contain personal data and must not reach the repo.
e2e/

# OS
.DS_Store
