# Copy to dashboard/.env.local and fill in. .env.local is gitignored.
# Everything here is read server-side only — none of it reaches the browser.

# ---- Resend ----------------------------------------------------------------
# From resend.com -> API Keys. Sending requires a VERIFIED domain (see the plan).
RESEND_API_KEY=

# The identity mail is signed as. This does NOT need to be a real mailbox —
# nothing is ever delivered to it; the DKIM DNS record is what authorises it.
EMAIL_FROM=Nordic Engros <post@nyhetsbrev.nordicengros.no>

# Where customer REPLIES go. This must be a real, monitored mailbox.
EMAIL_REPLY_TO=post@nordicengros.no

# Where unsubscribe mails land (List-Unsubscribe). Defaults to EMAIL_REPLY_TO.
# Someone has to actually read this inbox and untick the contact.
EMAIL_UNSUBSCRIBE_TO=post@nordicengros.no

# ---- Sending behaviour -----------------------------------------------------
# Requests per second. Resend allows 10/s per team; stay under it so a test-send
# or a second campaign never pushes the account over the limit.
EMAIL_RATE_PER_SEC=6

# 1 = rehearse without sending anything. The whole pipeline runs — throttling,
# logging, resume, progress — but no HTTP call is made to Resend.
# The dashboard shows a loud banner while this is on. Set to 0 to send for real.
EMAIL_DRY_RUN=1

# ---- Footer identity (printed in every campaign) ---------------------------
EMAIL_COMPANY_NAME=Nordic Engros AS
EMAIL_ORG_NR=922 796 076
EMAIL_ADDRESS=Oslo, Norge
EMAIL_WEBSITE=www.nordicengros.com

# ---- Storage ---------------------------------------------------------------
# Contact list and campaign logs. Defaults to worker/state/email (gitignored).
# This folder is the ONLY record of who has opted out — back it up.
# EMAIL_STATE_DIR=
# ---- Supabase (Postgres + Storage + Auth) ----------------------------------
# From the Supabase dashboard -> Project Settings -> API.
# Pick an EU region when CREATING the project — it cannot be changed afterwards.
SUPABASE_URL=

# The "anon / public" key. Used client-side for the login form ONLY. Safe to
# ship to the browser; it can read nothing on its own, because every table has
# RLS enabled with no policies.
SUPABASE_ANON_KEY=

# The "service_role / secret" key. Bypasses RLS entirely — this is full database
# access. Server-side only, never referenced from a component.
SUPABASE_SERVICE_ROLE_KEY=

# Private bucket holding the original supplier attachments.
SUPABASE_STORAGE_BUCKET=supplier-emails

# ---- Claude (price extraction) ---------------------------------------------
# From console.anthropic.com. Deliberately a DIFFERENT key from the worker's:
# a runaway extraction loop then cannot exhaust the catalogue classifier's quota.
ANTHROPIC_API_KEY=

# Vision-extracting prices off a messy scanned PDF is a harder task than the
# worker's product categorisation, so this defaults to a stronger model.
PRICE_EXTRACTION_MODEL=claude-sonnet-5

# 0 = skip the name/unit tidy-up pass on spreadsheets that are already clean.
PRICE_NORMALIZE_WITH_CLAUDE=1

# Below this, an extraction is sent to the review queue instead of trusted.
PRICE_EXTRACTION_CONFIDENCE_THRESHOLD=0.75

# Below this, a Claude-proposed product match needs a human to confirm it.
# Kept high on purpose: a wrong match produces a confidently wrong "cheapest".
PRODUCT_MATCH_AUTO_THRESHOLD=0.90

# ---- Inbound supplier email ------------------------------------------------
# Resend -> Webhooks -> signing secret for the endpoint. Verifies that a POST to
# /api/inbound/resend genuinely came from Resend.
RESEND_WEBHOOK_SECRET=

# The receiving domain and address configured in Resend (Inbound).
RESEND_INBOUND_DOMAIN=
RESEND_INBOUND_ADDRESS=

# ---- Worker (GitHub Actions) -----------------------------------------------
# Renders and the Shopify customer fetch run on an Actions runner: Vercel cannot
# spawn Python, and no free always-on host has the memory to encode video.
#
# Leave BOTH of these empty in development to keep spawning the worker locally
# instead — that is the switch, so testing a change does not mean pushing first.
# Fine-grained token with "Actions: read and write" on the repo below.
GITHUB_TOKEN=
GITHUB_REPO=shadyahmed41/nordicads
# Branch the workflow is dispatched against.
GITHUB_REF_NAME=main

# Shared secret the runner uses to post the fetched customer list back to
# /api/internal/sync-customers. Set the SAME value as a GitHub repo secret.
WORKER_SERVICE_TOKEN=

# ---- Scheduled jobs --------------------------------------------------------
# Vercel sends this as a bearer token on cron invocations. Without it the sync
# endpoint is a button anyone can press to spend Actions minutes and Shopify
# quota, so the route refuses to run when it is unset.
CRON_SECRET=

# ---- Migrations (optional, local only) -------------------------------------
# A Supabase access token, used to apply db/*.sql without the SQL editor.
# Not needed by the running app — leave it out of the hosting environment.
SUPABASE_ACCESS_TOKEN=
